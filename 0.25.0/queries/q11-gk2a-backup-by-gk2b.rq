PREFIX nmsc:  <https://w3id.org/nmsc/>
PREFIX sat:   <https://w3id.org/nmsc/satellite/>
PREFIX agcy:  <https://w3id.org/nmsc/agency/>
PREFIX drole: <https://w3id.org/nmsc/development-role/>
PREFIX var:   <https://w3id.org/nmsc/variable/>
PREFIX rel:   <https://w3id.org/nmsc/relevancy/>
PREFIX lim:   <https://w3id.org/nmsc/observing-limitation/>
PREFIX cap:   <https://w3id.org/nmsc/capability/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ins:   <https://w3id.org/nmsc/instrument/>
PREFIX asset: <https://w3id.org/nmsc/it-asset-type/>
PREFIX spdxc: <https://spdx.org/rdf/3.0.1/terms/Core/>
PREFIX spdxs: <https://spdx.org/rdf/3.0.1/terms/Software/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX qudt:  <http://qudt.org/schema/qudt/>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

# ── Q11. GK-2A 상실 시 GK-2B로 대체 가능한 변수와 등급 변화
#    백업 계획의 핵심 질의. 다른 위성 어휘를 import 하면 히마와리·GOES로도
#    같은 질의가 성립한다 (AMI와 AHI의 평가표는 37행 완전 동일).
SELECT ?변수 ?GK2A등급 ?GK2B등급
WHERE {
  ?c1 nmsc:capabilityOf ?i1 ; nmsc:observesVariable ?v ; nmsc:hasRelevancy ?r1 .
  ?i1 nmsc:carriedBy sat:gk-2a .
  ?r1 nmsc:relevancyRank ?GK2A등급 .
  OPTIONAL {
    ?c2 nmsc:capabilityOf ?i2 ; nmsc:observesVariable ?v ; nmsc:hasRelevancy ?r2 .
    ?i2 nmsc:carriedBy sat:gk-2b .
    ?r2 nmsc:relevancyRank ?GK2B등급 .
  }
  ?v skos:prefLabel ?변수 . FILTER(lang(?변수) = "ko")
}
ORDER BY ?GK2A등급 ?변수
