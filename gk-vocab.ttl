prod:rainfall-potential a skos:Concept ;
    skos:inScheme <https://w3id.org/nmsc/scheme/product> ;
    skos:topConceptOf <https://w3id.org/nmsc/scheme/product> ;
    skos:prefLabel "잠재강수량"@ko ;
    skos:definition "현재 강우 영역을 이동 방향으로 외삽해, 앞으로 일정 시간 동안 화소마다 내릴 누적 강우량을 예측한 초단기 예측. 천리안위성 2A호(GK-2A) AMI 관측으로 얻은 강우강도에 근거한다."@ko ;
    skos:definition "Very-short-range forecast of the rainfall that will accumulate at each pixel over a coming period, obtained by extrapolating current rain areas along their motion; based on rainfall rate derived from GK-2A AMI observations."@en ;
    skos:altLabel "Rainfall Potential"@en ;
    skos:altLabel "RP"@en ;
    nmsc:productGroup prgr:sg-precipitation ;
    nmsc:productCategory prcat:precipitation ;
