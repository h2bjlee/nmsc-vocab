prod:aerosol-detection a skos:Concept ;
    skos:inScheme <https://w3id.org/nmsc/scheme/product> ;
    skos:topConceptOf <https://w3id.org/nmsc/scheme/product> ;
    skos:prefLabel "에어로졸탐지"@ko ;
    skos:definition "천리안위성 2A호(GK-2A) AMI 관측으로 화소마다 대기 중 에어로졸이 있는지와 그 종류(화산재·황사·연무 등)를 판별한 결과."@ko ;
    skos:definition "Per-pixel determination, from GK-2A AMI observations, of whether aerosol is present in the atmosphere and of its type (volcanic ash, dust, haze, etc.)."@en ;
    skos:altLabel "Aerosol Detection Product"@en ;
    skos:altLabel "ADP"@en ;
