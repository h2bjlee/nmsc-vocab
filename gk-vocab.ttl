var:o3_total_column a skos:Concept ;
    skos:inScheme <https://w3id.org/nmsc/scheme/variable> ;
    skos:prefLabel "O3 Total Column"@en , "오존 전량"@ko ;
    skos:definition "지면에서 대기 꼭대기까지 이어지는 연직 대기 기둥 안에 든 오존의 총량을 수평 단위 면적당으로 나타낸 양. 흔히 돕슨 단위로 적는다."@ko ;
    skos:definition "Amount of ozone held in a vertical column of the atmosphere from the ground to the top of the atmosphere, per unit horizontal area; commonly expressed in Dobson units."@en ;
    skos:broader var:d-atmospheric-composition ;
    nmsc:isECV true ;
    nmsc:oscarRawValue "O3 Total Column" ;
    skos:exactMatch <https://space.oscar.wmo.int/variables/view/o3_total_column> ;
