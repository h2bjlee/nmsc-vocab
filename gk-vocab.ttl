    nmsc:estimatesVariable var:layer_precipitable_water ;
    nmsc:variableEvidence "Layer precipitable water ← MULTI_AAP·GK2A_AAP → gk2a-multi-aap·gk2a-aap 출력 LPW1, LPW2, LPW3 (mm, 계약 수량 layer_precipitable_water·boundary_layer_precipitable_water·middle_layer_precipitable_water·high_layer_precipitable_water; satwright 판 l(satwright-relations-20261116l.json, sha256 a1daf5aa) 계약 gk2a-multi-aap·gk2a-aap@0.1.5,0.2.5 — C1 규칙 \"계약에 쓰이는 변수만 SatSem 변수로\", status 130) — SatSem 소유 변수(status 130)"@ko ;
    nmsc:processingLevel plev:l2 ;
    nmsc:processingLevelEvidence "L2 ← GK2A_AAP → L2/AAP_TPW (GK2A_AUX_Mod_Write_L2.f90:846)"@ko ;
