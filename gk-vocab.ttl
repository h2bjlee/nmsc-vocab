var:cloud_top_height a skos:Concept ;
    skos:inScheme <https://w3id.org/nmsc/scheme/variable> ;
    skos:prefLabel "Cloud top height"@en , "운정 고도"@ko ;
    skos:definition "구름 꼭대기의 높이. 구름이 여러 층이면 가장 높은 구름의 꼭대기를 가리킨다."@ko ;
