var:sea_surface_temperature a skos:Concept ;
    skos:inScheme <https://w3id.org/nmsc/scheme/variable> ;
    skos:prefLabel "Sea surface temperature"@en , "해수면온도"@ko ;
    skos:definition "해면에서의 바닷물 온도. 수 m 깊이를 대표하는 벌크 수온과 최상층 1 mm 안의 피부 수온을 구별한다."@ko ;
    skos:definition "Temperature of sea water at the surface; the bulk temperature (representative of a depth of a few metres) is distinguished from the skin temperature (within the uppermost millimetre)."@en ;
    skos:altLabel "해수면 온도"@ko ;
    skos:editorialNote "대표 라벨 '해수면온도'는 2026-11-15 사용자 결정(용어집 SST 뜻과 통일 — 2019 NMSC 약어 용어표 SST 와 NMSC 산출물 목록 prod:sst 의 표기). 띄어 쓴 '해수면 온도'는 v0.3 부터의 대표 라벨이라 altLabel 로 내렸다(status 96)."@ko ;
    skos:broader var:d-ocean ;
    nmsc:isECV true ;
    nmsc:oscarRawValue "Sea surface temperature" ;
    skos:exactMatch <https://space.oscar.wmo.int/variables/view/sea_surface_temperature> ;
    dct:source <https://space.oscar.wmo.int/variables/view/sea_surface_temperature> ;
    skos:closeMatch <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0381/> ;
    skos:closeMatch <https://gcmd.earthdata.nasa.gov/kms/concept/bd24a9a9-7d52-4c29-b2a0-6cefd216ae78> ;
    dct:source "CF Standard Name Table v95 (2026-09-16) / NVS P07, 2026-11-11 수집·IRI 확인. OSCAR 변수 정의·측정 단위와 대조"@ko ;
    dct:source "NASA GCMD Keywords 25.2 (rev 2026-11-10), 2026-11-11 수집·IRI·라벨 확인"@ko ;
    nmsc:inclusionBasis "oscar-instrument-evaluation" ;
    skos:scopeNote "GK 계열 탑재체의 관측 능력에 등장하는 변수만 포함한다. OSCAR 변수 237개 전체를 복제하지 않는다."@ko , "Only variables that appear in the observing capabilities of GK series payloads are included. The full set of 237 OSCAR variables is not copied."@en .

