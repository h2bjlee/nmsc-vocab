prod:dust-emission a skos:Concept ;
    skos:inScheme <https://w3id.org/nmsc/scheme/product> ;
    skos:topConceptOf <https://w3id.org/nmsc/scheme/product> ;
    skos:prefLabel "황사배출량"@ko ;
    skos:definition "지표에서 바람에 의해 대기 중으로 날려 올라가는 황사(먼지)의 양을 단위 면적·단위 시간당 질량(배출 플럭스)으로 나타낸 값. 수치모델 기상장과 위성으로 얻은 지표 상태를 함께 써서 계산한다."@ko ;
    skos:definition "Amount of dust (Asian dust) lifted from the surface into the atmosphere by wind, expressed as mass per unit area per unit time (emission flux), computed from numerical model meteorology together with satellite-derived surface conditions."@en ;
    nmsc:productGroup prgr:sg-dust-monitoring ;
    nmsc:productCategory prcat:aerosol ;
    nmsc:relatedPhenomenon prphen:asian-dust ;
    nmsc:operationalAlgorithm "GK2A_DF" ;
    nmsc:producedByAlgorithm alg:gk2a-df ;
    nmsc:generationMethod genm:modelled ;
    nmsc:estimatesVariable var:dust_emission_flux ;
    nmsc:variableEvidence "Dust emission flux ← GK2A_DF → gk2a-df 출력 DF (ug m-2 s-1, 계약 수량 dust_emission_flux; satwright 판 l(satwright-relations-20261116l.json, sha256 a1daf5aa) 계약 gk2a-df@0.1.4,0.2.4 — C1 규칙 \"계약에 쓰이는 변수만 SatSem 변수로\", status 130) — SatSem 소유 변수(status 130)"@ko ;
    nmsc:processingLevel plev:l4 ;
