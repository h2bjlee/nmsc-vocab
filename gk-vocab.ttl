    nmsc:operationalAlgorithm "MULTI_AAP" ;
    nmsc:producedByAlgorithm alg:gk2a-aap ;
    nmsc:producedByAlgorithm alg:multi-aap ;
    nmsc:generationMethod genm:retrieved ;
    nmsc:temporalRelation trel:observation ;
    nmsc:operationalL1BInput ins:ami ;
