# 11. 관측 능력 (탑재체 × 변수)
# ----------------------------------------------------------------------------
#   주의: 출처는 기기 범주 템플릿이다. NMSC 실제 산출물 목록이 아니다.
# ----------------------------------------------------------------------------

cap:mi-accumulated_precipitation a nmsc:ObservingCapability ;
    rdfs:label "MI — Accumulated precipitation"@en ;
    nmsc:capabilityOf ins:mi ;
    nmsc:observesVariable var:accumulated_precipitation ;
    nmsc:hasRelevancy rel:4 ;
    nmsc:hasLimitation lim:convective-precipitation-dominant ;
    nmsc:hasLimitation lim:calibration-by-mw-needed ;
    nmsc:isPrimaryObjective false ;
    dct:source <https://space.oscar.wmo.int/instruments/view/mi> .

