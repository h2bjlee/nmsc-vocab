    nmsc:satelliteObservationBased true ;
    nmsc:processingLevel plev:l2 ;
    nmsc:processingLevelEvidence "L2 ← GK2A_QPN → L2/QPN_AUX (GK2A_AUX_Mod_Write_L2.f90:13239); GK2A_QPN → L2/QPN (GK2A_AUX_Mod_Write_L2.f90:13360) — 7b(status 107): 알고리즘 대응 추정 → 확실(satwright 판 i 계약 근거)"@ko ;
    nmsc:derivedFromInstrument ins:ami ;
    nmsc:instrumentEvidence "AMI ← GK2A_QPN ← L2/RR(GK2A_RR) ← AMI L1B (run_gk2a_rr.sh:21) — 7b(status 107): 알고리즘 대응 추정 → 확실(satwright 판 i 계약 근거)"@ko ;
