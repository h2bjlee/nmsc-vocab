    skosxl:altLabel plab:aerosol-particle-size--695e0abca7 ;
    skos:altLabel "Aerosol Particle Size"@en ;
    skosxl:altLabel plab:aerosol-particle-size--261194fac5 ;
    skos:altLabel "AMI aerosol angstrom exponent"@en ;
