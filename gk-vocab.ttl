var:cloud_drop_effective_radius a skos:Concept ;
    skos:inScheme <https://w3id.org/nmsc/scheme/variable> ;
    skos:prefLabel "Cloud drop effective radius"@en , "구름 물방울 유효반경"@ko ;
    skos:definition "구름 물방울 크기 분포를 대표하는 반경으로, 물방울 크기 분포의 부피 적분을 단면적 적분으로 나눈 값."@ko ;
    skos:definition "Radius representative of the cloud droplet size distribution, given by the volume integral of the distribution divided by its cross-sectional-area integral."@en ;
    skos:broader var:d-cloud ;
    nmsc:isECV true ;
    nmsc:oscarRawValue "Cloud drop effective radius" ;
    skos:exactMatch <https://space.oscar.wmo.int/variables/view/cloud_drop_effective_radius> ;
    dct:source <https://space.oscar.wmo.int/variables/view/cloud_drop_effective_radius> ;
