    nmsc:isECV false ;
    nmsc:oscarRawValue "Upward long-wave irradiance at Earth surface" ;
    skos:exactMatch <https://space.oscar.wmo.int/variables/view/upward_long_wave_irradiance_at_earth_surface> ;
    dct:source <https://space.oscar.wmo.int/variables/view/upward_long_wave_irradiance_at_earth_surface> ;
    skos:closeMatch <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0235/> ;
