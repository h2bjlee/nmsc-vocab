    nmsc:satelliteObservationBased true ;
    nmsc:estimatesVariable var:downward_short_wave_radiant_exposure_at_earth_surface ;
    nmsc:variableEvidence "Downward short-wave radiant exposure at Earth surface ← GK2A_AI_DSR → gk2a-ai-dsr 출력 DSR (MJ m-2, 계약 수량 surface_downwelling_shortwave_energy_ai; satwright 판 l(satwright-relations-20261116l.json, sha256 a1daf5aa) 계약 gk2a-ai-dsr@0.1.4,0.2.4 — C1 규칙 \"계약에 쓰이는 변수만 SatSem 변수로\", status 130) — SatSem 소유 변수(status 130)"@ko ;
