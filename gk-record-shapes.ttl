@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix nmsc:  <https://w3id.org/nmsc/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# NMSC 위성 어휘 C15 단계 2 기록 셰이프 — 생성물. 손으로 고치지 말 것.
# 원천: 요소 표 (요소 74개), 규칙 표 (규칙 22행).
# 대상: 실행 기록(인스턴스) — 처리 실행·자료 객체·자료 변수·입력 사용·불확도 성분·검증 기록. 본 어휘(gk-vocab.ttl)에는 이 클래스의
#       인스턴스가 없다. 개념 값의 스킴 검사(SR18)는 본 어휘를 함께 올려야 한다.
# 수준: M = sh:Violation, R = sh:Warning, C = 조건이 참이면 Violation(거짓이면 then_level), O = 값 모양만. SHACL Core 만(sh:sparql 없음).
# 국가기상위성센터 자료처리 모델러는 이 셰이프가 아니라 같은 원천의 표(c15-elements.json)를 읽는다.
# 실행: shacl validate --shapes gk-record-shapes.ttl --data gk-vocab.ttl --data <기록>.ttl
# ============================================================================

nmsc:RecordDataObjectShape a sh:NodeShape ;
    sh:targetClass nmsc:DataObject ;
    rdfs:label "자료 객체 요소(값 모양·개수)"@ko ;
    sh:property [ sh:path dct:identifier ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:message "do.identifier (식별자): 값은 문자열 리터럴(xsd:string 또는 언어 태그)이어야 한다"@ko ] ;
    sh:property [ sh:path dct:identifier ; sh:maxCount 1 ; sh:message "do.identifier (식별자): 최대 1개"@ko ] ;
    sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "do.identifier (식별자): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:ofProduct ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/product> ] ] ; sh:message "do.product (산출물 유형): 값은 scheme/product 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:ofProduct ; sh:maxCount 1 ; sh:message "do.product (산출물 유형): 최대 1개"@ko ] ;
    sh:property [ sh:path ( nmsc:ofProduct nmsc:processingLevel ) ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/processing-level> ] ] ; sh:message "do.processing-level (처리 수준): 값은 scheme/processing-level 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:exampleData ; sh:datatype xsd:boolean ; sh:message "do.example-data (예시 자료 여부): 값은 xsd:boolean 리터럴이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:exampleData ; sh:maxCount 1 ; sh:message "do.example-data (예시 자료 여부): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:exampleData ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "do.example-data (예시 자료 여부): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:useCondition ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/use-condition> ] ] ; sh:message "do.use-condition (이용 조건 범주): 값은 scheme/use-condition 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:useCondition ; sh:maxCount 1 ; sh:message "do.use-condition (이용 조건 범주): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:useCondition ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "do.use-condition (이용 조건 범주): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path dct:license ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "do.license (라이선스): 권장 — 최소 1개"@ko ] ;
    sh:property [ sh:path dct:format ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "do.format (형식): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:nodeKind sh:BlankNodeOrIRI ; sh:message "do.generated-by (생성 실행): 값은 노드 여야 한다"@ko ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:nodeKind sh:BlankNodeOrIRI ; sh:message "do.derived-from (원천 자료): 값은 노드 여야 한다"@ko ] ;
    sh:property [ sh:path nmsc:validTime ; sh:datatype xsd:dateTime ; sh:message "do.valid-time (유효 시각): 값은 xsd:dateTime 리터럴이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:validTime ; sh:maxCount 1 ; sh:message "do.valid-time (유효 시각): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:validTime ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "do.valid-time (유효 시각): 권장 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:referenceTime ; sh:datatype xsd:dateTime ; sh:message "do.reference-time (발표 시각): 값은 xsd:dateTime 리터럴이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:referenceTime ; sh:maxCount 1 ; sh:message "do.reference-time (발표 시각): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:leadTime ; sh:datatype xsd:duration ; sh:message "do.lead-time (선행 시간): 값은 xsd:duration 리터럴이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:leadTime ; sh:maxCount 1 ; sh:message "do.lead-time (선행 시간): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:generationMethod ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/generation-method> ] ] ; sh:message "do.generation-method (생성 방법(기본값)): 값은 scheme/generation-method 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:generationMethod ; sh:maxCount 1 ; sh:message "do.generation-method (생성 방법(기본값)): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:temporalRelation ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/temporal-relation> ] ] ; sh:message "do.temporal-relation (시간 관계(기본값)): 값은 scheme/temporal-relation 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:temporalRelation ; sh:maxCount 1 ; sh:message "do.temporal-relation (시간 관계(기본값)): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:hasDataVariable ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class nmsc:DataVariable ; sh:message "do.variable (자료 변수): 값은 노드 (nmsc:DataVariable) 여야 한다"@ko ] .

nmsc:RecordVariableShape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "자료 변수 요소(값 모양·개수)"@ko ;
    sh:property [ sh:path nmsc:variableName ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:message "var.name (변수 이름): 값은 문자열 리터럴(xsd:string 또는 언어 태그)이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:variableName ; sh:maxCount 1 ; sh:message "var.name (변수 이름): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:variableName ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "var.name (변수 이름): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:unitSymbol ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:message "var.unit (단위): 값은 문자열 리터럴(xsd:string 또는 언어 태그)이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:unitSymbol ; sh:maxCount 1 ; sh:message "var.unit (단위): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:unitSymbol ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "var.unit (단위): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:quantityName ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:message "var.quantity (물리량): 값은 문자열 리터럴(xsd:string 또는 언어 태그)이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:quantityName ; sh:maxCount 1 ; sh:message "var.quantity (물리량): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:quantityName ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "var.quantity (물리량): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:variableKind ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/variable-kind> ] ] ; sh:message "var.kind (변수 종류): 값은 scheme/variable-kind 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:variableKind ; sh:maxCount 1 ; sh:message "var.kind (변수 종류): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:variableKind ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "var.kind (변수 종류): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:calibrationStage ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/calibration-stage> ] ] ; sh:message "var.calibration-stage (보정 단계): 값은 scheme/calibration-stage 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:calibrationStage ; sh:maxCount 1 ; sh:message "var.calibration-stage (보정 단계): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:encodingStatus ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/encoding-status> ] ] ; sh:message "var.encoding-status (형식 상태): 값은 scheme/encoding-status 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:encodingStatus ; sh:maxCount 1 ; sh:message "var.encoding-status (형식 상태): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:encodingStatus ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "var.encoding-status (형식 상태): 권장 — 최소 1개"@ko ] ;
    sh:property [ sh:path [ sh:alternativePath ( nmsc:generationMethod ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:generationMethod ) ) ] ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/generation-method> ] ] ; sh:message "var.generation-method (생성 방법): 값은 scheme/generation-method 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path [ sh:alternativePath ( nmsc:generationMethod ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:generationMethod ) ) ] ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "var.generation-method (생성 방법): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path [ sh:alternativePath ( nmsc:temporalRelation ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:temporalRelation ) ) ] ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/temporal-relation> ] ] ; sh:message "var.temporal-relation (시간 관계): 값은 scheme/temporal-relation 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path [ sh:alternativePath ( nmsc:temporalRelation ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:temporalRelation ) ) ] ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "var.temporal-relation (시간 관계): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:representsVariable ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/variable> ] ] ; sh:message "var.represents (관측 변수): 값은 scheme/variable 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:representsVariable ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "var.represents (관측 변수): 권장 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:traceabilityLevel ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/traceability-level> ] ] ; sh:message "var.traceability (SI 소급 등급): 값은 scheme/traceability-level 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:traceabilityLevel ; sh:maxCount 1 ; sh:message "var.traceability (SI 소급 등급): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:combinedStandardUncertainty ; sh:datatype xsd:decimal ; sh:message "var.combined-uncertainty (합성 표준 불확도): 값은 xsd:decimal 리터럴이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:combinedStandardUncertainty ; sh:maxCount 1 ; sh:message "var.combined-uncertainty (합성 표준 불확도): 최대 1개"@ko ] .

nmsc:RecordRunShape a sh:NodeShape ;
    sh:targetClass nmsc:ProcessingRun ;
    rdfs:label "처리 실행 요소(값 모양·개수)"@ko ;
    sh:property [ sh:path ( prov:qualifiedAssociation prov:hadPlan dct:type ) ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/algorithm> ] ] ; sh:message "run.plan.algorithm (알고리즘): 값은 scheme/algorithm 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path ( prov:qualifiedAssociation prov:hadPlan dct:type ) ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "run.plan.algorithm (알고리즘): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path ( prov:qualifiedAssociation prov:hadPlan dcat:version ) ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:message "run.plan.version (알고리즘 판): 값은 문자열 리터럴(xsd:string 또는 언어 태그)이어야 한다"@ko ] ;
    sh:property [ sh:path ( prov:qualifiedAssociation prov:hadPlan dcat:version ) ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "run.plan.version (알고리즘 판): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:computeStatus ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/compute-status> ] ] ; sh:message "run.compute (계산 상태): 값은 scheme/compute-status 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:computeStatus ; sh:maxCount 1 ; sh:message "run.compute (계산 상태): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:computeStatus ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "run.compute (계산 상태): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:qualityStatus ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/quality-status> ] ] ; sh:message "run.quality (품질 상태): 값은 scheme/quality-status 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:qualityStatus ; sh:maxCount 1 ; sh:message "run.quality (품질 상태): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:qualityStatus ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "run.quality (품질 상태): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:publicationStatus ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/publication-status> ] ] ; sh:message "run.publication (공개 상태): 값은 scheme/publication-status 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path nmsc:publicationStatus ; sh:maxCount 1 ; sh:message "run.publication (공개 상태): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:publicationStatus ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "run.publication (공개 상태): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path prov:startedAtTime ; sh:datatype xsd:dateTime ; sh:message "run.started (시작 시각): 값은 xsd:dateTime 리터럴이어야 한다"@ko ] ;
    sh:property [ sh:path prov:startedAtTime ; sh:maxCount 1 ; sh:message "run.started (시작 시각): 최대 1개"@ko ] ;
    sh:property [ sh:path prov:startedAtTime ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "run.started (시작 시각): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path prov:endedAtTime ; sh:datatype xsd:dateTime ; sh:message "run.ended (종료 시각): 값은 xsd:dateTime 리터럴이어야 한다"@ko ] ;
    sh:property [ sh:path prov:endedAtTime ; sh:maxCount 1 ; sh:message "run.ended (종료 시각): 최대 1개"@ko ] ;
    sh:property [ sh:path prov:qualifiedUsage ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class prov:Usage ; sh:message "run.usage (입력 사용): 값은 노드 (prov:Usage) 여야 한다"@ko ] .

nmsc:RecordUsageShape a sh:NodeShape ;
    sh:targetClass prov:Usage ;
    rdfs:label "입력 사용 요소(값 모양·개수)"@ko ;
    sh:property [ sh:path prov:entity ; sh:nodeKind sh:BlankNodeOrIRI ; sh:message "usage.entity (입력 자료): 값은 노드 여야 한다"@ko ] ;
    sh:property [ sh:path prov:entity ; sh:maxCount 1 ; sh:message "usage.entity (입력 자료): 최대 1개"@ko ] ;
    sh:property [ sh:path prov:entity ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "usage.entity (입력 자료): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path prov:hadRole ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue <https://w3id.org/nmsc/scheme/input-role> ] ] ; sh:message "usage.role (입력 역할): 값은 scheme/input-role 의 개념이어야 한다(SR18)"@ko ] ;
    sh:property [ sh:path prov:hadRole ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "usage.role (입력 역할): 권장 — 최소 1개"@ko ] ;
    sh:property [ sh:path ( prov:entity dcat:version ) ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:message "usage.entity.version (입력 자료 판): 값은 문자열 리터럴(xsd:string 또는 언어 태그)이어야 한다"@ko ] .

nmsc:RecordComponentShape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "불확도 성분 요소(값 모양·개수)"@ko ;
    sh:property [ sh:path nmsc:componentOf ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class nmsc:DataVariable ; sh:message "comp.of (출력 변수): 값은 노드 (nmsc:DataVariable) 여야 한다"@ko ] ;
    sh:property [ sh:path nmsc:componentOf ; sh:maxCount 1 ; sh:message "comp.of (출력 변수): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:componentOf ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "comp.of (출력 변수): 필수 — 최소 1개"@ko ] ;
    sh:property [ sh:path nmsc:effectId ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:message "comp.effect-id (효과 id): 값은 문자열 리터럴(xsd:string 또는 언어 태그)이어야 한다"@ko ] ;
    sh:property [ sh:path nmsc:effectId ; sh:maxCount 1 ; sh:message "comp.effect-id (효과 id): 최대 1개"@ko ] ;
    sh:property [ sh:path nmsc:effectId ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "comp.effect-id (효과 id): 필수 — 최소 1개"@ko ] ;
