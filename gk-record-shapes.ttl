nmsc:RecordDoProductShape a sh:NodeShape ;
    sh:targetClass nmsc:DataObject ;
    rdfs:label "do.product — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:and ( [ sh:property [ sh:path nmsc:exampleData ; sh:hasValue false ] ] [ sh:property [ sh:path nmsc:useCondition ; sh:hasValue <https://w3id.org/nmsc/use-condition/public> ] ] ) ] ] [ sh:property [ sh:path nmsc:ofProduct ; sh:minCount 1 ] ] ) ;
    sh:message "do.product (산출물 유형): 조건 [do.example-data eq false and do.use-condition eq public] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordDoReferenceTimeShape a sh:NodeShape ;
    sh:targetClass nmsc:DataObject ;
    rdfs:label "do.reference-time — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:temporalRelation ; sh:hasValue <https://w3id.org/nmsc/temporal-relation/forecast> ] ] ] [ sh:property [ sh:path nmsc:referenceTime ; sh:minCount 1 ] ] ) ;
    sh:message "do.reference-time (발표 시각): 조건 [do.temporal-relation eq forecast] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordDoLeadTimeShape a sh:NodeShape ;
    sh:targetClass nmsc:DataObject ;
    rdfs:label "do.lead-time — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:temporalRelation ; sh:hasValue <https://w3id.org/nmsc/temporal-relation/forecast> ] ] ] [ sh:property [ sh:path nmsc:leadTime ; sh:minCount 1 ] ] ) ;
    sh:message "do.lead-time (선행 시간): 조건 [do.temporal-relation eq forecast] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordVarCalibrationStageShape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "var.calibration-stage — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:ofProduct nmsc:processingLevel ) ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/processing-level/l1b> ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:property [ sh:path nmsc:calibrationStage ; sh:minCount 1 ] ] ) ;
    sh:message "var.calibration-stage (보정 단계): 조건 [do.processing-level in [l1b]] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordVarCalibrationStageOtherwiseShape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "var.calibration-stage — 조건이 거짓이면 권장(R)"@ko ;
    sh:severity sh:Warning ;
    sh:or ( [ sh:property [ sh:path ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:ofProduct nmsc:processingLevel ) ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/processing-level/l1b> ) ] ; sh:qualifiedMinCount 1 ] ] [ sh:property [ sh:path nmsc:calibrationStage ; sh:minCount 1 ] ] ) ;
    sh:message "var.calibration-stage (보정 단계): 조건 [do.processing-level in [l1b]] 이 거짓이면 권장(R) — 최소 1개"@ko .

nmsc:RecordRunEndedShape a sh:NodeShape ;
    sh:targetClass nmsc:ProcessingRun ;
    rdfs:label "run.ended — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:computeStatus ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/compute-status/succeeded> <https://w3id.org/nmsc/compute-status/failed> <https://w3id.org/nmsc/compute-status/cancelled> ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:property [ sh:path prov:endedAtTime ; sh:minCount 1 ] ] ) ;
    sh:message "run.ended (종료 시각): 조건 [run.compute in [succeeded failed cancelled]] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordUsageEntityVersionShape a sh:NodeShape ;
    sh:targetClass prov:Usage ;
    rdfs:label "usage.entity.version — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path prov:hadRole ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/input-role/calibration> <https://w3id.org/nmsc/input-role/static> ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:property [ sh:path ( prov:entity dcat:version ) ; sh:minCount 1 ] ] ) ;
    sh:message "usage.entity.version (입력 자료 판): 조건 [usage.role in [calibration static]] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordCompMethodShape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "comp.method — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:not [ sh:property [ sh:path nmsc:uncertaintyStatus ; sh:hasValue <https://w3id.org/nmsc/uncertainty-status/unknown> ] ] ] ] [ sh:property [ sh:path nmsc:uncertaintyMethod ; sh:minCount 1 ] ] ) ;
    sh:message "comp.method (평가 방법): 조건 [not comp.status eq unknown] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordCompUpstreamStatusShape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "comp.upstream-status — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:carriedFromUpstream ; sh:hasValue true ] ] ] [ sh:property [ sh:path nmsc:upstreamStatus ; sh:minCount 1 ] ] ) ;
    sh:message "comp.upstream-status (원래 상태): 조건 [comp.carried eq true] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordCompBasedOnValidationShape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "comp.based-on-validation — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:uncertaintyMethod ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/uncertainty-method/validation> <https://w3id.org/nmsc/uncertainty-method/validation-residual> ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:property [ sh:path nmsc:basedOnValidation ; sh:minCount 1 ] ] ) ;
    sh:message "comp.based-on-validation (근거 검증 기록): 조건 [comp.method in [validation validation_residual]] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordValBiasShape a sh:NodeShape ;
    sh:targetClass nmsc:ValidationRecord ;
    rdfs:label "val.bias — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:and ( [ sh:not [ sh:property [ sh:path nmsc:standardDeviation ; sh:minCount 1 ] ] ] [ sh:not [ sh:property [ sh:path nmsc:rmsd ; sh:minCount 1 ] ] ] ) ] ] [ sh:property [ sh:path nmsc:bias ; sh:minCount 1 ] ] ) ;
    sh:message "val.bias (편향): 조건 [not val.standard-deviation exists and not val.rmsd exists] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordValStandardDeviationShape a sh:NodeShape ;
    sh:targetClass nmsc:ValidationRecord ;
    rdfs:label "val.standard-deviation — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:and ( [ sh:not [ sh:property [ sh:path nmsc:bias ; sh:minCount 1 ] ] ] [ sh:not [ sh:property [ sh:path nmsc:rmsd ; sh:minCount 1 ] ] ] ) ] ] [ sh:property [ sh:path nmsc:standardDeviation ; sh:minCount 1 ] ] ) ;
    sh:message "val.standard-deviation (표준편차): 조건 [not val.bias exists and not val.rmsd exists] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordValRmsdShape a sh:NodeShape ;
    sh:targetClass nmsc:ValidationRecord ;
    rdfs:label "val.rmsd — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:and ( [ sh:not [ sh:property [ sh:path nmsc:bias ; sh:minCount 1 ] ] ] [ sh:not [ sh:property [ sh:path nmsc:standardDeviation ; sh:minCount 1 ] ] ] ) ] ] [ sh:property [ sh:path nmsc:rmsd ; sh:minCount 1 ] ] ) ;
    sh:message "val.rmsd (RMSD): 조건 [not val.bias exists and not val.standard-deviation exists] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordValUnitShape a sh:NodeShape ;
    sh:targetClass nmsc:ValidationRecord ;
    rdfs:label "val.unit — 조건부 필수(C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:or ( [ sh:property [ sh:path nmsc:bias ; sh:minCount 1 ] ] [ sh:property [ sh:path nmsc:standardDeviation ; sh:minCount 1 ] ] [ sh:property [ sh:path nmsc:rmsd ; sh:minCount 1 ] ] ) ] ] [ sh:property [ sh:path nmsc:unitSymbol ; sh:minCount 1 ] ] ) ;
    sh:message "val.unit (통계 단위): 조건 [val.bias exists or val.standard-deviation exists or val.rmsd exists] 이 참이면 필수(C) — 최소 1개"@ko .

nmsc:RecordSR1Shape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR1 — 성분 중 상태 propagated 가 있으면 분류 input·상태 unknown 인 성분이 없어야 한다"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:property [ sh:path nmsc:uncertaintyStatus ; sh:hasValue <https://w3id.org/nmsc/uncertainty-status/propagated> ] ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:not [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:and ( [ sh:property [ sh:path nmsc:uncertaintySource ; sh:hasValue <https://w3id.org/nmsc/uncertainty-source/input> ] ] [ sh:property [ sh:path nmsc:uncertaintyStatus ; sh:hasValue <https://w3id.org/nmsc/uncertainty-status/unknown> ] ] ) ] ; sh:qualifiedMinCount 1 ] ] ] ) ;
    sh:message "SR1: 성분 중 상태 propagated 가 있으면 분류 input·상태 unknown 인 성분이 없어야 한다"@ko .

nmsc:RecordSR2Shape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR2 — 상태 unknown 성분이 하나라도 있으면 합성 표준 불확도가 없어야 한다"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:property [ sh:path nmsc:uncertaintyStatus ; sh:hasValue <https://w3id.org/nmsc/uncertainty-status/unknown> ] ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:not [ sh:property [ sh:path nmsc:combinedStandardUncertainty ; sh:minCount 1 ] ] ] ) ;
    sh:message "SR2: 상태 unknown 성분이 하나라도 있으면 합성 표준 불확도가 없어야 한다"@ko .

nmsc:RecordSR3Shape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR3 — 상관 structured 성분이 있으면 합성 표준 불확도가 없어야 한다"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:property [ sh:path nmsc:errorCorrelation ; sh:hasValue <https://w3id.org/nmsc/error-correlation/structured> ] ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:not [ sh:property [ sh:path nmsc:combinedStandardUncertainty ; sh:minCount 1 ] ] ] ) ;
    sh:message "SR3: 상관 structured 성분이 있으면 합성 표준 불확도가 없어야 한다"@ko .

nmsc:RecordSR4Shape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR4 — 변수 종류가 범주형·비트마스크면 성분의 표준 불확도와 변수의 합성 표준 불확도가 없어야 한다"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:variableKind ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/variable-kind/categorical> <https://w3id.org/nmsc/variable-kind/bitmask> ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:and ( [ sh:not [ sh:property [ sh:path nmsc:combinedStandardUncertainty ; sh:minCount 1 ] ] ] [ sh:not [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:property [ sh:path nmsc:standardUncertainty ; sh:minCount 1 ] ] ; sh:qualifiedMinCount 1 ] ] ] ) ] ) ;
    sh:message "SR4: 변수 종류가 범주형·비트마스크면 성분의 표준 불확도와 변수의 합성 표준 불확도가 없어야 한다"@ko .

nmsc:RecordSR6Shape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "SR6 — 상태 unknown 이면 표준 불확도가 없어야 한다"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:uncertaintyStatus ; sh:hasValue <https://w3id.org/nmsc/uncertainty-status/unknown> ] ] ] [ sh:not [ sh:property [ sh:path nmsc:standardUncertainty ; sh:minCount 1 ] ] ] ) ;
    sh:message "SR6: 상태 unknown 이면 표준 불확도가 없어야 한다"@ko .

nmsc:RecordSR7Shape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "SR7 — 알고리즘 오차 세부 분류는 분류가 algorithm 일 때만"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:algorithmErrorCategory ; sh:minCount 1 ] ] ] [ sh:property [ sh:path nmsc:uncertaintySource ; sh:hasValue <https://w3id.org/nmsc/uncertainty-source/algorithm> ] ] ) ;
    sh:message "SR7: 알고리즘 오차 세부 분류는 분류가 algorithm 일 때만"@ko .

nmsc:RecordSR8Shape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "SR8 — 이어받은 성분(carriedFromUpstream true)은 원래 상태 하나와 출처 실행 또는 출처 알고리즘이 있어야 한다(원래 상태는 요소 comp.upstream-status 의 C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:carriedFromUpstream ; sh:hasValue true ] ] ] [ sh:or ( [ sh:property [ sh:path nmsc:effectOriginRun ; sh:minCount 1 ] ] [ sh:property [ sh:path nmsc:effectOriginAlgorithm ; sh:minCount 1 ] ] ) ] ) ;
    sh:message "SR8: 이어받은 성분(carriedFromUpstream true)은 원래 상태 하나와 출처 실행 또는 출처 알고리즘이 있어야 한다(원래 상태는 요소 comp.upstream-status 의 C)"@ko .

nmsc:RecordSR9Shape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "SR9 — 효과 id 는 하나이고 패턴 ^[a-z0-9_.:-]+$ 에 맞아야 한다(개수는 요소 comp.effect-id)"@ko ;
    sh:severity sh:Violation ;
    sh:and ( [ sh:property [ sh:path nmsc:effectId ; sh:pattern "^[a-z0-9_.:-]+$" ] ] ) ;
    sh:message "SR9: 효과 id 는 하나이고 패턴 ^[a-z0-9_.:-]+$ 에 맞아야 한다(개수는 요소 comp.effect-id)"@ko .

nmsc:RecordSR10Shape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR10 — 검증 통계(잔차 아님)로 낸 algorithm 성분과 input 성분을 함께 두면 이중 계산일 수 있다"@ko ;
    sh:severity sh:Warning ;
    sh:or ( [ sh:not [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:and ( [ sh:property [ sh:path nmsc:uncertaintySource ; sh:hasValue <https://w3id.org/nmsc/uncertainty-source/algorithm> ] ] [ sh:property [ sh:path nmsc:uncertaintyMethod ; sh:hasValue <https://w3id.org/nmsc/uncertainty-method/validation> ] ] ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:not [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:property [ sh:path nmsc:uncertaintySource ; sh:hasValue <https://w3id.org/nmsc/uncertainty-source/input> ] ] ; sh:qualifiedMinCount 1 ] ] ] ) ;
    sh:message "SR10: 검증 통계(잔차 아님)로 낸 algorithm 성분과 input 성분을 함께 두면 이중 계산일 수 있다"@ko .

nmsc:RecordSR11Shape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR11 — L3·L4 산출물 변수에 표본(sampling) 성분이 없다 — 산출물에 수준이 여럿이면 과할 수 있다"@ko ;
    sh:severity sh:Warning ;
    sh:or ( [ sh:not [ sh:property [ sh:path ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:ofProduct nmsc:processingLevel ) ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/processing-level/l3> <https://w3id.org/nmsc/processing-level/l4> ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:property [ sh:path [ sh:inversePath nmsc:componentOf ] ; sh:qualifiedValueShape [ sh:property [ sh:path nmsc:uncertaintySource ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/uncertainty-source/sampling> <https://w3id.org/nmsc/uncertainty-source/random-subsampling> <https://w3id.org/nmsc/uncertainty-source/sampling-bias> ) ] ; sh:qualifiedMinCount 1 ] ] ; sh:qualifiedMinCount 1 ] ] ) ;
    sh:message "SR11: L3·L4 산출물 변수에 표본(sampling) 성분이 없다 — 산출물에 수준이 여럿이면 과할 수 있다"@ko .

nmsc:RecordSR12Shape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "SR12 — 방법 gum 인데 분포가 정규가 아니다 — Monte Carlo 확인 안 됨"@ko ;
    sh:severity sh:Warning ;
    sh:and ( [ sh:not [ sh:and ( [ sh:property [ sh:path nmsc:uncertaintyMethod ; sh:hasValue <https://w3id.org/nmsc/uncertainty-method/gum> ] ] [ sh:property [ sh:path nmsc:uncertaintyDistribution ; sh:minCount 1 ] ] [ sh:not [ sh:property [ sh:path nmsc:uncertaintyDistribution ; sh:hasValue <https://w3id.org/nmsc/uncertainty-distribution/normal> ] ] ] ) ] ] ) ;
    sh:message "SR12: 방법 gum 인데 분포가 정규가 아니다 — Monte Carlo 확인 안 됨"@ko .

nmsc:RecordSR13Shape a sh:NodeShape ;
    sh:targetClass nmsc:ValidationRecord ;
    rdfs:label "SR13 — 개발 시험 검증 기록은 조정·시험 자료 겹침을 확인했어야 한다(splitOverlapChecked true)"@ko ;
    sh:severity sh:Warning ;
    sh:or ( [ sh:not [ sh:property [ sh:path nmsc:validationKind ; sh:hasValue <https://w3id.org/nmsc/validation-kind/development> ] ] ] [ sh:property [ sh:path nmsc:splitOverlapChecked ; sh:hasValue true ] ] ) ;
    sh:message "SR13: 개발 시험 검증 기록은 조정·시험 자료 겹침을 확인했어야 한다(splitOverlapChecked true)"@ko .

nmsc:RecordSR15Shape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR15 — 시간 관계 forecast(변수 값, 없으면 객체 값)면 선행 시간이 있어야 한다(자료 객체 쪽은 요소 do.lead-time 의 C)"@ko ;
    sh:severity sh:Violation ;
    sh:or ( [ sh:not [ sh:property [ sh:path [ sh:alternativePath ( nmsc:temporalRelation ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:temporalRelation ) ) ] ; sh:hasValue <https://w3id.org/nmsc/temporal-relation/forecast> ] ] ] [ sh:property [ sh:path ( [ sh:inversePath nmsc:hasDataVariable ] nmsc:leadTime ) ; sh:minCount 1 ] ] ) ;
    sh:message "SR15: 시간 관계 forecast(변수 값, 없으면 객체 값)면 선행 시간이 있어야 한다(자료 객체 쪽은 요소 do.lead-time 의 C)"@ko .

nmsc:RecordSR16ComponentShape a sh:NodeShape ;
    sh:targetClass nmsc:UncertaintyComponent ;
    rdfs:label "SR16 — 표준 불확도는 음이 아니다"@ko ;
    sh:severity sh:Violation ;
    sh:and ( [ sh:property [ sh:path nmsc:standardUncertainty ; sh:minInclusive 0 ] ] ) ;
    sh:message "SR16: 표준 불확도는 음이 아니다"@ko .

nmsc:RecordSR16VariableShape a sh:NodeShape ;
    sh:targetClass nmsc:DataVariable ;
    rdfs:label "SR16 — 합성 표준 불확도는 음이 아니다"@ko ;
    sh:severity sh:Violation ;
    sh:and ( [ sh:property [ sh:path nmsc:combinedStandardUncertainty ; sh:minInclusive 0 ] ] ) ;
    sh:message "SR16: 합성 표준 불확도는 음이 아니다"@ko .

nmsc:RecordSR21Shape a sh:NodeShape ;
    sh:targetClass prov:Usage ;
    rdfs:label "SR21 — 입력 역할이 calibration·static 인 사용에는 입력 자료의 유효 기간(dct:valid)을 두는 것이 좋다"@ko ;
    sh:severity sh:Warning ;
    sh:or ( [ sh:not [ sh:property [ sh:path prov:hadRole ; sh:qualifiedValueShape [ sh:in ( <https://w3id.org/nmsc/input-role/calibration> <https://w3id.org/nmsc/input-role/static> ) ] ; sh:qualifiedMinCount 1 ] ] ] [ sh:property [ sh:path ( prov:entity dct:valid ) ; sh:minCount 1 ] ] ) ;
    sh:message "SR21: 입력 역할이 calibration·static 인 사용에는 입력 자료의 유효 기간(dct:valid)을 두는 것이 좋다"@ko .
