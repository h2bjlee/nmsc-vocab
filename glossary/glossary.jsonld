   "nmsc:abbreviation": [
    {
     "@value": "SOCC"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "Satellite Operations Control Center",
     "@language": "en"
    },
    {
     "@value": "위성운영관제센터",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "위성망 관제센터는 미국, 프랑스, 호주, 한국의 지구국에 설치되어 있는 위성 원격 제어 시스템을 통하여 위성의 온도 및 전력, 각 부분의 동작 상태, 위치 등의 데이터를 수집하고, 이 데이터에 따라 위성의 궤도 및 위치, 기타 위성의 여러 상태를 제어하는 기능을 수행",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
   "nmsc:glossaryStatus": [
    {
     "@id": "gstat:official"
    }
   ],
   "dct:source": [
    {
     "@value": "NMSC 약어 용어표 d1.2 (2019-05-01) 원본 행 1412 — 뜻 SOCC",
     "@language": "ko"
    }
   ]
  },
