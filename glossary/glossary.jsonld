    }
   ],
   "nmsc:abbreviation": [
    {
     "@value": "6S"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "Second Simulation of a Satellite Signal in the Solar Spectrum",
     "@language": "en"
    },
    {
     "@value": "6S 복사전달모델",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "대기 중 산란·흡수를 고려해 태양 반사 파장대의 위성·항공기 관측 신호를 모의하는 복사전달 코드로, 5S의 후속판이며 MODIS 대기보정 조견표 계산에 쓰인다.",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
