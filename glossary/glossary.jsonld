     "@language": "ko"
    }
   ]
  },
  {
   "@id": "gl:g0326",
   "@type": [
    "nmsc:GlossaryEntry"
   ],
   "dct:isPartOf": [
    {
     "@id": "nmsc:glossary"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "Cloud top height estimation",
     "@language": "en"
    },
    {
     "@value": "운정고도 산출",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "구름 지역의 적외 데이타로부터 수증기 등에 의한 복사량감쇄 효과를 보정하여 운정온도를 구하고 이것과 미리 주어진 기온의 연직분포의 기후값을 비교하여 운정 고도를 구한다. 기온 연직 분포의 기후값은 위경도 5도마다 매월 작성된 GMSSA(GMS표준대기) 데이터를 이용하고 있음. 운정고도 산출처리에는 대상 구름 지역의 넓이에 의해 전체 운정고도 산출 처리와 국지 운정고도 산출 처리 등 두 종류가 있다.",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
   "nmsc:glossaryStatus": [
    {
     "@id": "gstat:official"
    }
   ],
   "dct:source": [
    {
     "@value": "NMSC 약어 용어표 d1.2 (2019-05-01) 원본 행 215 — 뜻 Cloud top height estimation",
     "@language": "ko"
    }
   ]
  },
