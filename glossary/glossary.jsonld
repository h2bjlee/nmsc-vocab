     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "TBB 분포도라고 부르며 VISSR 적외 데이터의 휘도온도를 격자 평균하여 등치선을 그린 그림",
     "@language": "ko"
    }
   ],
