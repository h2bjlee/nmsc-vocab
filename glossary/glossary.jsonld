  {
   "@id": "gl:g0561",
   "@type": [
    "nmsc:GlossaryEntry"
   ],
   "dct:isPartOf": [
    {
     "@id": "nmsc:glossary"
    }
   ],
   "nmsc:abbreviation": [
    {
     "@value": "IRES"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "Infra-Red Earth Sensor",
     "@language": "en"
    },
    {
     "@value": "적외선 지구센서",
     "@language": "ko"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Infra-Red 2 Axes Earth Sensor",
     "@language": "en"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "지구의 적외선 복사 에너지(주로 이산화탄소 흡수대인 14~16 µm 영역)를 감지해 위성의 자세를 파악하는 광학 센서의 일반 명칭으로, 위성의 자세 조정을 위해 사용한다. 축에 따라 두 형식이 있다. 단축(1축)형은 회전 안정화 위성이나 단일 축만 정밀 제어하는 소형 위성에 쓰며, 위성이 회전하며 지구 지평선을 가로지르는 시간(Earth chord width)으로 1개 축의 자세 오차를 계산한다. 2축형(Infra-Red 2 Axes Earth Sensor)은 3축 안정화 위성의 핵심 부품으로, 정지궤도·저궤도 위성에서 지구 지평선을 상하좌우 4방향으로 감지해 Roll·Pitch 두 축의 오차를 동시에 측정한다. 지구 센서는 지구를 바라보는 축의 회전(Yaw)을 직접 측정할 수 없어 3축형은 없다. 지구 지향 3축 제어 위성에서 가장 널리 쓰여 흔히 IRES라 하면 2축형을 가리킨다",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
   "nmsc:glossaryStatus": [
    {
     "@id": "gstat:official"
    }
   ],
   "dct:source": [
    {
     "@value": "NMSC 약어 용어표 d1.2 (2019-05-01) 원본 행 783 — 뜻 IRES",
     "@language": "ko"
    }
   ]
