   "skos:prefLabel": [
    {
     "@value": "Global Environment Monitoring System",
     "@language": "en"
    },
    {
     "@value": "전지구 환경감시 체계",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "유엔환경계획(UNEP)의 전지구 환경감시 프로그램. 스톡홀름 유엔인간환경회의의 Earthwatch 구상에서 나와 각국의 대기·수질 등 환경 관측망을 연결하고 자료를 모아 평가한다. 천리안위성 2B호의 환경탑재체 GEMS(Geostationary Environment Monitoring Spectrometer)와는 약어만 같은 다른 대상이다",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
