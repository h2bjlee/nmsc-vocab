   "skos:prefLabel": [
    {
     "@value": "Cloud amount determination",
     "@language": "en"
    },
    {
     "@value": "운량 산출",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "1일 4회의 적외 데이터를 히스토그램으로 해석하여 구름지역을 판별하고 위경도 1도 간격의 격자점에 5일 평균 운량, 상, 중, 하층 및 전운량 등을 구하여 그 분포도를 작성하는 처리.",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
   "nmsc:glossaryStatus": [
    {
