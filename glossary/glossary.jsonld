   "nmsc:abbreviation": [
    {
     "@value": "CCC"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "Cross Correlation Contribution",
     "@language": "en"
    },
    {
     "@value": "교차상관계수를 이용한 고도할당방법",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "위성바람장 산출과정에서 구름의 고도를 추정(할당)하는 방법 중의 하나. 구름을 표적으로 하는 경우, 벡터추적과정에서 연속된 위성영상의 휘도온도에서 산출되는 상관계수를 표적 내 각 화소의 기여도로 계산하여 구름고도를 추정함",
     "@language": "ko"
    }
   ],
