   "skos:prefLabel": [
    {
     "@value": "Blocking",
     "@language": "en"
    },
    {
     "@value": "태양광 신호 차단",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "GMS에서는 위성의 자세 및 안테나 제어를 위하여 기준신호, 태양, 지구 센서 신호를 이용하고 있는데, 위성 궤도에 의해 지구센서에 태양 빛이 들어와 위성 자세 결정을 처리하기 곤란해지기 때문에 telemetry 복조기로 강제적으로 태양 광에 의한 신호를 차단하는 것을 말한다.",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
   "nmsc:glossaryStatus": [
    {
     "@id": "gstat:official"
    }
   ],
   "dct:source": [
    {
     "@value": "NMSC 약어 용어표 d1.2 (2019-05-01) 원본 행 113 — 뜻 Blocking",
     "@language": "ko"
    }
   ]
  },
  {
