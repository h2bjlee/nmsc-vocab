   "skos:prefLabel": [
    {
     "@value": "Overshooting",
     "@language": "en"
    },
    {
     "@value": "오버슈팅",
     "@language": "ko"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "오버슈팅(overshooting) 현상은 운정의 일부분이 대류권계면 고도(평균 약 11km) 이상으로 발달된 것으로, 매우 강력한 대류 활동을 의미하며, 토네이도와 같은 위험기상을 유발할 수 있는 가능성이 매우 높다고 볼 수 있음",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
