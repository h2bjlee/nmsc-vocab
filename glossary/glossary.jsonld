   "nmsc:abbreviation": [
    {
     "@value": "INTERSPUTNIK"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "International Organization of Space Communications",
     "@language": "en"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "1971년 11월 15일 설립 협정이 체결된 정부간 국제 우주통신 기구로, 회원국에 위성 중계기 용량 임대, 지상국, 궤도·주파수 자원 관리 등 위성통신 서비스를 제공한다.",
     "@language": "ko"
    }
   ],
   "nmsc:glossaryAuthority": [
    {
     "@id": "gauth:external"
    }
   ],
   "nmsc:glossaryStatus": [
    {
     "@id": "gstat:official"
    }
   ],
   "dct:source": [
    {
     "@value": "NMSC 약어 용어표 d1.2 (2019-05-01) 원본 행 747 — 뜻 INTERSPUTNIK",
     "@language": "ko"
    },
    {
     "@id": "https://intersputnik.int/about/organization/"
    }
   ]
  },
