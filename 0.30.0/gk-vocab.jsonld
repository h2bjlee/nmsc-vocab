   "skos:prefLabel": [
    {
     "@value": "삼각분포",
     "@language": "ko"
    },
    {
     "@value": "Triangular distribution",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "triangular"
    }
   ],
   "skos:definition": [
    {
     "@value": "가운데 값일수록 확률이 높고 상·하한에서 0이 되는 대칭 삼각형 분포.",
     "@language": "ko"
    },
    {
     "@value": "A symmetric triangular distribution whose probability is highest at the middle value and falls to zero at the upper and lower limits.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "영어 정의(skos:definition @en)는 번역 검토 전이다",
     "@language": "ko"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://www.bipm.org/documents/20126/2071204/JCGM_100_2008_E.pdf"
    }
   ],
   "dct:source": [
    {
     "@value": "어휘 관리자 결정(2026-11-14)",
     "@language": "ko"
    },
    {
     "@value": "원 제안: 조사 문서 04 (다른 프로젝트가 만든 조사 자료, 2026-11-14 받음 — 값은 제안이며 표준 분류가 아니다) 3절 성분 예시 distribution('정규·직사각형 등') — GUM 4.3.9",
     "@language": "ko"
    },
    {
     "@value": "참고 규범: JCGM 100:2008 (GUM) 4.3.9 — 대칭 사다리꼴 분포에서 β = 0 이면 삼각분포. 2026-11-15 원본을 열어 조항 번호·문구 확인",
     "@language": "ko"
    }
   ]
  },
