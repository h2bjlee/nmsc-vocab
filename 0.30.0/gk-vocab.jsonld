   "skos:prefLabel": [
    {
     "@value": "딥러닝 대류운 전조탐지",
     "@language": "ko"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-convective-initiation"
    }
   ],
   "nmsc:productCategory": [
