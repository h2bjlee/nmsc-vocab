   "skos:definition": [
    {
     "@value": "화산재 구름이 있는 곳에서 단위 면적 위 대기 기둥 안 화산재의 총질량을 천리안위성 2A호(GK-2A) AMI 관측으로 추정한 값.",
     "@language": "ko"
    },
    {
     "@value": "Total mass of volcanic ash per unit area in the atmospheric column where a volcanic ash cloud is present, estimated from GK-2A AMI observations.",
     "@language": "en"
    }
