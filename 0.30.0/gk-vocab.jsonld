     "@language": "ko"
    },
    {
     "@value": "Uncertainty effect identifier (the satellite data processing modeler's contract field effect_id, pattern [a-z0-9_.:-]+ — SR9). Kept unchanged when carried into later stages. The naming rule is open in design records of the satellite data processing modeler (not public).",
     "@language": "en"
    }
   ],
   "dct:source": [
    {
     "@value": "실행 계보 기록 설계 — 이름은 NMSC 위성 어휘의 판단(2026-11-15 확정)",
     "@language": "ko"
    }
   ]
  },
