   ],
   "skos:prefLabel": [
    {
     "@value": "실측",
     "@language": "ko"
    },
    {
     "@value": "Measured",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "measured"
    }
   ],
   "skos:definition": [
    {
     "@value": "기기가 직접 측정한 값. 예: L1B 자료, 현장 관측(AWS·부이).",
     "@language": "ko"
    },
    {
     "@value": "A value measured directly by an instrument. Examples: L1B data, in-situ observations (AWS, buoys).",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "영어 정의(skos:definition @en)는 번역 검토 전이다",
     "@language": "ko"
    }
   ],
   "dct:source": [
    {
     "@value": "어휘 관리자 결정(2026-11-14)",
     "@language": "ko"
    },
    {
     "@value": "원 제안: 위성자료처리 모델러 설계 기록(비공개) '자료 객체 정의: 핵심·확장 층, 의무 수준, 자료 종류·단위·기원·시간 관계·이용 조건과 DBOM' (상태: 제안, 2026-11-14 작성 — 2026-11-15 읽어 값 확인) 생성 방법 표 — 위성자료처리 모델러 설계 기록(비공개) 표 measured",
     "@language": "ko"
    }
   ]
  },
  {
   "@id": "genm:retrieved",
   "@type": [
    "skos:Concept"
   ],
   "skos:inScheme": [
    {
     "@id": "nmsc:scheme/generation-method"
    }
   ],
   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/generation-method"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "관측에서 추정",
     "@language": "ko"
    },
    {
     "@value": "Retrieved",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "retrieved"
    }
   ],
   "skos:definition": [
    {
     "@value": "관측에서 물리·통계 알고리즘으로 추정한 값. 예: 구름·해수면온도 같은 L2 산출물.",
     "@language": "ko"
    },
    {
     "@value": "A value estimated from observations with a physical or statistical algorithm. Example: L2 products such as cloud or sea surface temperature.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "영어 정의(skos:definition @en)는 번역 검토 전이다",
     "@language": "ko"
    }
   ],
   "dct:source": [
    {
     "@value": "어휘 관리자 결정(2026-11-14)",
     "@language": "ko"
    },
    {
     "@value": "원 제안: 위성자료처리 모델러 설계 기록(비공개) '자료 객체 정의: 핵심·확장 층, 의무 수준, 자료 종류·단위·기원·시간 관계·이용 조건과 DBOM' (상태: 제안, 2026-11-14 작성 — 2026-11-15 읽어 값 확인) 생성 방법 표 — 위성자료처리 모델러 설계 기록(비공개) 표 retrieved",
     "@language": "ko"
    }
   ]
  },
  {
