   ],
   "skos:prefLabel": [
    {
     "@value": "산불방사열",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "탐지된 화재 화소에서 화재가 복사로 내보내는 에너지의 일률을 단위 면적당으로 나타낸 값.",
     "@language": "ko"
    },
    {
     "@value": "Power radiated by fire within a detected fire pixel, expressed per unit area.",
     "@language": "en"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-wildfire-monitoring"
    }
   ],
