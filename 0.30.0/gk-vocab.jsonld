   "skos:notation": [
    {
     "@value": "public"
    }
   ],
   "skos:definition": [
    {
     "@value": "누구나 이용할 수 있다.",
     "@language": "ko"
    },
    {
     "@value": "Anyone may use it.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
