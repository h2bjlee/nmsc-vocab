  {
   "@id": "prod:dstar-dust-detection",
   "@type": [
    "skos:Concept"
   ],
   "skos:inScheme": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "D*parameter 황사탐지",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "적외 채널 밝기온도 차를 조합한 경험 지수(D*)로 황사(먼지) 화소를 탐지하고 그 강도를 나타낸 결과. 황사 농도나 광학두께가 아니다.",
     "@language": "ko"
    },
    {
     "@value": "Detection of dust pixels, and indication of their intensity, by an empirical index (D*) combining infrared brightness-temperature differences; it is not dust concentration or optical depth.",
     "@language": "en"
    }
   ],
