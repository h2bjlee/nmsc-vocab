   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "강수확률",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "현재 강우 영역의 이동을 외삽해, 가까운 미래에 화소마다 일정 강도 이상의 비가 내릴 확률을 나타낸 초단기 예측. 천리안위성 2A호(GK-2A) AMI 관측으로 얻은 강우강도에 근거한다.",
     "@language": "ko"
    },
    {
     "@value": "Very-short-range forecast giving, per pixel, the probability of rain at or above a set intensity in the near future, obtained by extrapolating the motion of current rain areas; based on rainfall rate derived from GK-2A AMI observations.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "정의는 검토 전 초안이다(확신도 보통) — 이름과 실체가 다르다 — 이름과 처리 계약 수량은 '3시간 이내 1 mm 이상'인데 운영 알고리즘 분석 자료로는 실제 가중이 첫 40분 창이다. 그래서 기간·문턱을 정의에 쓰지 않았다 — 확인되면 넣는다",
     "@language": "ko"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Probability of Rainfall",
     "@language": "en"
    },
    {
     "@value": "POR",
     "@language": "en"
    },
