   ],
   "skos:prefLabel": [
    {
     "@value": "해양 감시",
     "@language": "ko"
    },
    {
     "@value": "Ocean monitoring",
     "@language": "en"
    }
   ],
   "skos:definition": [
    {
     "@value": "바다의 상태를 감시하고 해양을 예보하는 데 쓰이는 산출물에 붙는 활용 축 값.",
     "@language": "ko"
    },
    {
     "@value": "Application-axis value for products used to keep watch on the state of the sea and to forecast it.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "정의는 검토 전 초안이다(확신도 보통)",
     "@language": "ko"
    }
   ],
   "skos:scopeNote": [
    {
     "@value": "해양 상태 감시·해양 예보에 쓰는 산출물",
     "@language": "ko"
    },
    {
     "@value": "Products used for ocean state monitoring and ocean forecasting",
     "@language": "en"
    }
   ],
   "skos:closeMatch": [
    {
     "@id": "http://codes.wmo.int/wmdr/ApplicationArea/17"
    }
   ],
   "nmsc:coverageNote": [
    {
     "@value": "WMO 응용 영역 번호 코드 17 '3.1 Ocean Forecasting and Real-Time Monitoring' 에 closeMatch — 해양 상태 감시·해양 예보라는 이 값의 범위와 같다. WMO 확인 기록(reg:statusStable, 2026-11-17T17:11:20Z)",
     "@language": "ko"
    }
   ],
   "dct:source": [
