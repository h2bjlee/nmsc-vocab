     "@value": "L2 ← GK2A_LSE → L2/LSE (출력 쓰기 모듈)",
     "@language": "ko"
    }
   ],
   "nmsc:derivedFromInstrument": [
    {
     "@id": "ins:ami"
    }
   ],
