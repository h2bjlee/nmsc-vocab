   ],
   "skos:definition": [
    {
     "@value": "지구 표면과 대기가 방출해 대기 상한에서 우주로 나가는 장파 복사의 복사조도를 천리안위성 2A호(GK-2A) AMI 관측으로 추정한 값.",
     "@language": "ko"
    },
    {
     "@value": "Irradiance of longwave radiation emitted by the Earth's surface and atmosphere that leaves the top of the atmosphere to space, estimated from GK-2A AMI observations.",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
