   ],
   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "성층권 침투 대류운",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "뇌우 구름의 상승기류가 대류권계면을 뚫고 성층권까지 솟은 구름 꼭대기(오버슈팅 탑)가 있는 화소를 탐지한 결과.",
     "@language": "ko"
    },
    {
     "@value": "Detection of pixels containing overshooting tops — cloud tops of thunderstorms whose updrafts penetrate the tropopause into the stratosphere.",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Overshooting Top",
     "@language": "en"
    },
    {
     "@value": "OT",
     "@language": "en"
    }
   ],
   "nmsc:productGroup": [
    {
