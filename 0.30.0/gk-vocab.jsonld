     "@id": "drole:space-weather"
    }
   ],
   "nmsc:coverageNote": [
    {
     "@value": "제공 기관은 OSCAR/Space 값을 그대로 옮긴 것이며 NMSC 확인 전이다.",
     "@language": "ko"
    },
    {
     "@value": "미발사",
     "@language": "ko"
    }
   ],
