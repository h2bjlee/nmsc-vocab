   "skos:definition": [
    {
     "@value": "하루 해수면온도 분석값이 같은 날짜의 기후 평균에서 벗어난 정도(편차)와, 그 편차를 기후 표준편차에 비춘 등급.",
     "@language": "ko"
    },
    {
     "@value": "Departure of the daily sea surface temperature analysis from the climatological mean for the same calendar day, together with a category of that departure relative to the climatological standard deviation.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
