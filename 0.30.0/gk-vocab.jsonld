    {
     "@id": "nmsc:DataVariable"
    }
   ],
   "rdfs:range": [
    {
     "@id": "nmsc:scheme/variable-kind"
    }
   ],
   "rdfs:comment": [
    {
     "@value": "연속형·범주형·비트마스크. 범주형·비트마스크 변수에는 표준 불확도를 달지 않는다(SR4).",
     "@language": "ko"
    },
