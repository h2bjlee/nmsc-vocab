    }
   ],
   "skos:prefLabel": [
    {
     "@value": "정규화식생지수",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "근적외와 적색 반사도의 차이를 둘의 합으로 나눈 정규화 식생지수(NDVI)로, 식생의 양을 나타낸다. 천리안위성 2A호(GK-2A) AMI 관측으로 산출한다.",
     "@language": "ko"
    },
    {
     "@value": "Normalized difference vegetation index (NDVI) — the difference between near-infrared and red reflectances divided by their sum — indicating the amount of vegetation, derived from GK-2A AMI observations.",
     "@language": "en"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-vegetation-monitoring"
    }
   ],
   "nmsc:productCategory": [
    {
