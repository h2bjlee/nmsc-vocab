    }
   ],
   "dct:isReplacedBy": [
    {
     "@id": "disp:convective-lifecycle-forecast-attributes"
    }
   ],
   "skos:changeNote": [
    {
     "@value": "2026-11-17 폐기: 표출물(산출물로 만든 그림·지점 표)이라 산출물이 아니다 — 표출물 스킴의 disp:convective-lifecycle-forecast-attributes 로 옮겼다. 알고리즘 출력·입력 노드와 처리 수준 같은 사실은 이 개념에 그대로 둔다. IRI 는 남는다. 근거: 어휘 관리자 결정(2026-11-17).",
     "@language": "ko"
    }
   ],
