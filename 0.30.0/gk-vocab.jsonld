   "@id": "var:overshooting_top_occurrence",
   "@type": [
    "skos:Concept"
   ],
   "skos:inScheme": [
    {
     "@id": "nmsc:scheme/variable"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "Overshooting top occurrence",
     "@language": "en"
    },
    {
     "@value": "오버슈팅 탑 발생",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "뇌우 구름의 상승기류가 대류권계면을 뚫고 성층권까지 솟은 구름 꼭대기(오버슈팅 탑)가 있는지를 나타내는 판정.",
     "@language": "ko"
    },
    {
     "@value": "Determination of whether an overshooting top — a thunderstorm cloud top whose updraft penetrates the tropopause into the stratosphere — is present.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "정의는 검토 전 초안이다(확신도 보통)",
     "@language": "ko"
    },
    {
     "@value": "GCMD broadMatch(EARTH SCIENCE > ATMOSPHERE > CLOUDS > CONVECTIVE CLOUDS/SYSTEMS (OBSERVED/ANALYZED) > DEEP CONVECTIVE CLOUD SYSTEMS): NMSC 위성 어휘가 정의한 변수",
     "@language": "ko"
    }
   ],
   "skos:broader": [
    {
     "@id": "var:d-cloud"
    }
   ],
   "nmsc:coverageNote": [
    {
     "@value": "OSCAR/Space 237개(2026-11-15 API 조회 목록, 2026-11-17 대조)에 대응 없음",
     "@language": "ko"
    },
    {
     "@value": "CF 대응 없음: CF 에 오버슈팅 탑 표준 이름이 없다",
     "@language": "ko"
    }
   ],
   "dct:source": [
    {
     "@value": "변수 추가 확인 기록 (2026-11-17: CF Standard Name Table v95, NVS P07 SPARQL·IRI 열람, GCMD KMS 25.3 science keywords·개념 IRI 열람) — 어휘 관리자 결정(2026-11-17)",
