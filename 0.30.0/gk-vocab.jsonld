   "skos:prefLabel": [
    {
     "@value": "Sea surface temperature",
     "@language": "en"
    },
    {
     "@value": "해수면온도",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "해면에서의 바닷물 온도. 수 m 깊이를 대표하는 벌크 수온과 최상층 1 mm 안의 피부 수온을 구별한다.",
     "@language": "ko"
    },
    {
     "@value": "Temperature of sea water at the surface; the bulk temperature (representative of a depth of a few metres) is distinguished from the skin temperature (within the uppermost millimetre).",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "해수면 온도",
     "@language": "ko"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "대표 라벨 '해수면온도'는 어휘 관리자 결정(2026-11-15)이다 — 용어집 SST 뜻과 통일(2019 NMSC 약어 용어표 SST 와 NMSC 산출물 목록 prod:sst 의 표기). 띄어 쓴 '해수면 온도'는 그전의 대표 라벨이라 altLabel 로 내렸다.",
     "@language": "ko"
    }
   ],
   "skos:broader": [
