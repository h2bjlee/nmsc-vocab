   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "지표면알베도",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "지표면이 받은 태양 복사를 모든 방향으로 반사하는 비율(반구 반사율)로, 흑체하늘·백색하늘 알베도를 분광·광대역으로 나타낸다.",
     "@language": "ko"
    },
    {
     "@value": "Fraction of incident solar radiation reflected by the surface in all directions (hemispherical reflectance), given as black-sky and white-sky albedo in spectral and broadband forms.",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Surface Albedo",
     "@language": "en"
    },
    {
     "@value": "SAL",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "2019 약어 용어표 SAL: 2019 표의 한글 '지표면 반사도'가 다른 산출물(지표면반사도)을 가리켜 처음에는 잇지 않았으나, 알고리즘 근거로 영문 쪽이 맞다고 판단해 연결했다. 한글 표기는 2019 표의 오기로 본다",
     "@language": "ko"
    }
   ],
   "nmsc:productGroup": [
    {
