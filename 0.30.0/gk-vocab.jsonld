  {
   "@id": "prod:typhoon-hazard",
   "@type": [
    "skos:Concept"
   ],
   "skos:inScheme": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "태풍 위험요소(강수, 바람)",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "태풍 둘레의 바람 위험을 나타내는 값 — 기압면별 바람 성분, 최대 풍속, 최대풍속 반경, 정한 풍속(15·25 m s⁻¹) 이상의 강풍 반경 — 을 위성 관측에 근거한 태풍 강도·구름 정보와 수치모델 바람으로 추정한 것.",
     "@language": "ko"
    },
    {
     "@value": "Values describing the wind hazard around a tropical cyclone — wind components on pressure levels, maximum wind speed, radius of maximum wind, and radii of winds at or above set speeds (15 and 25 m s⁻¹) — estimated from cyclone intensity and cloud information derived from satellite observations together with numerical model winds.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "정의는 검토 전 초안이다(확신도 보통) — 이름과 실체가 다르다 — 이름의 '(강수, 바람)' 가운데 강수를 내는 처리가 운영 코드에서 확인되지 않아(운영 알고리즘 분석 자료) 정의는 바람 기준이다, 강수가 확인되면 넓힌다. 와류 모형은 구현 사항이라 정의에 넣지 않았다",
     "@language": "ko"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-typhoon-analysis"
    }
   ],
   "nmsc:productCategory": [
    {
     "@id": "prcat:wind"
    }
   ],
   "nmsc:relatedPhenomenon": [
    {
     "@id": "prphen:tropical-cyclone"
    }
   ],
