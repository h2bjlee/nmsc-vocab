   "@id": "var:relative_humidity",
   "@type": [
    "skos:Concept"
   ],
   "skos:inScheme": [
    {
     "@id": "nmsc:scheme/variable"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "Relative humidity",
     "@language": "en"
    },
    {
     "@value": "상대습도",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "공기가 포화에 얼마나 가까운지를 나타내는 값 — 같은 기온에서 공기가 담을 수 있는 최대 수증기량에 대한 실제 수증기량의 비율.",
     "@language": "ko"
    },
    {
     "@value": "How close air is to saturation: its actual water-vapour content relative to the most it could hold at the same temperature.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "정의는 검토 전 초안이다(확신도 보통) — 영어 정의는 GCMD 정의 문장과 겹치지 않게 다시 썼다",
     "@language": "ko"
    },
    {
     "@value": "CF closeMatch(relative_humidity): NMSC 위성 어휘가 정의한 변수. CF 단위 1, GK-2A RH_profile 은 % — 같은 차원",
     "@language": "ko"
    }
   ],
   "skos:broader": [
    {
