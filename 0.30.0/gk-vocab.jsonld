   ],
   "nmsc:estimatesVariable": [
    {
     "@id": "var:probability_of_rainfall"
    }
   ],
   "nmsc:variableEvidence": [
    {
     "@value": "Probability of rainfall ← GK2A_QPN → 출력 POR (%, 계약 수량 probability_of_rainfall_over_1mm_3h; 위성자료처리 모델러 계약의 유형 관계 목록(비공개, 2026-11-16 판 l) 계약 — 처리 계약에 쓰이는 변수만 NMSC 위성 어휘의 변수로 둔다, 어휘 관리자 결정(2026-11-17)) — NMSC 위성 어휘가 정의한 변수. 다음 3시간 1 mm 넘는 비의 확률",
     "@language": "ko"
    }
   ],
   "nmsc:processingLevel": [
    {
     "@id": "plev:l2"
    }
   ],
   "nmsc:processingLevelEvidence": [
    {
     "@value": "L2 ← GK2A_QPN → L2/QPN_AUX (출력 쓰기 모듈); GK2A_QPN → L2/QPN (출력 쓰기 모듈) — 알고리즘 대응 추정 → 확실(위성자료처리 모델러 계약의 유형 관계 목록(비공개, 판 i) 계약 근거)",
     "@language": "ko"
    }
   ],
