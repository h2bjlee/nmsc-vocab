   ],
   "skos:prefLabel": [
    {
     "@value": "총오존량",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "지표에서 대기 상한까지 대기 기둥에 든 오존의 총량(보통 돕슨 단위로 나타냄)을 천리안위성 2A호(GK-2A) AMI 관측으로 추정한 값.",
     "@language": "ko"
    },
    {
     "@value": "Total amount of ozone in the atmospheric column from the surface to the top of the atmosphere (usually expressed in Dobson units), estimated from GK-2A AMI observations.",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Total column Ozone",
     "@language": "en"
    },
    {
     "@value": "TOZ",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "2019 약어 용어표 TOZ: 원문 Top 은 Total 의 오기(용어집 정정표 TOZ, 2026-11-11) — label_en 으로 바로잡음(2026-11-13)",
     "@language": "ko"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-aviation-monitoring"
    }
