     "@id": "nmsc:scheme/variable"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "PM10 mass concentration",
     "@language": "en"
    },
    {
     "@value": "PM10 질량 농도",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "공기 단위 부피에 들어 있는 지름 10 µm 이하 입자의 질량.",
     "@language": "ko"
    },
    {
     "@value": "Mass of particles with diameter of 10 µm or less per unit volume of air.",
     "@language": "en"
    }
   ],
