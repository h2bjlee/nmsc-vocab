   "skos:prefLabel": [
    {
     "@value": "대기운동벡터",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "연속한 천리안위성 2A호(GK-2A) AMI 영상에서 구름이나 수증기 패턴의 이동을 추적해 구한 바람 벡터(풍향·풍속)와 그 대표 고도.",
     "@language": "ko"
    },
    {
     "@value": "Wind vectors (direction and speed), with their representative heights, derived by tracking the motion of cloud or water-vapour features in successive GK-2A AMI images.",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Atmospheric Motion Vector",
     "@language": "en"
    },
    {
     "@value": "AMV",
     "@language": "en"
    }
   ],
