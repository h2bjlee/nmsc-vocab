   ],
   "skos:definition": [
    {
     "@value": "지표면에 도달하는 태양 단파 복사의 복사조도(지표 하향 단파 복사)를 천리안위성 2A호(GK-2A) AMI 관측으로 추정한 값.",
     "@language": "ko"
    },
    {
     "@value": "Irradiance of solar (shortwave) radiation reaching the Earth's surface, estimated from GK-2A AMI observations.",
     "@language": "en"
    }
