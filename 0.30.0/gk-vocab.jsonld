     "@value": "AI 기반 토양수분",
     "@language": "ko"
    }
   ],
   "skosxl:altLabel": [
    {
     "@id": "plab:ai-soil-moisture--1e9f6f91a4"
    }
   ],
   "nmsc:coverageNote": [
    {
     "@value": "공간 해상도·산출 주기: 근거 없음",
