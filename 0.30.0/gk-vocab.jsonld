   ],
   "skos:prefLabel": [
    {
     "@value": "대류권접힘난류탐지",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "대류권계면 접힘(성층권 공기가 대류권 깊이 내려오는 현상)에 따라 청천난류가 일어날 가능성이 있는 영역을 수증기 채널 영상에서 탐지한 결과.",
     "@language": "ko"
    },
    {
     "@value": "Detection, from water-vapour channel imagery, of areas where clear-air turbulence is likely in association with tropopause folding (intrusion of stratospheric air deep into the troposphere).",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
