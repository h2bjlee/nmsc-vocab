     "@language": "ko"
    },
    {
     "@value": "Vertical profiles of temperature and humidity, precipitable water, atmospheric stability. Variable domains var:d-temperature, var:d-water-vapour",
     "@language": "en"
    }
   ],
   "skos:narrowMatch": [
