    {
     "@value": "정규식생지수",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "근적외(식생 반사도 최대)와 적색(최소) 반사도의 차이를 둘의 합으로 정규화한 지수로, 식생의 총량을 대표한다.",
     "@language": "ko"
    },
    {
     "@value": "Difference between the near-infrared (maximum) and red (minimum) vegetation reflectances normalised by their sum; representative of total biomass.",
     "@language": "en"
    }
   ],
