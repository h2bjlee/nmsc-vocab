    },
    {
     "@value": "Evaluated",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "evaluated"
    }
   ],
   "skos:definition": [
    {
     "@value": "독립 참조와 비교해 평가했다. 검증 잔차로 추정했으면 상태 값을 늘리지 않고 평가 방법 validation-residual 로 표시한다.",
     "@language": "ko"
    },
    {
     "@value": "Evaluated by comparison with an independent reference. If it was estimated from validation residuals, no extra status value is added; it is marked with the evaluation method validation-residual instead.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "영어 정의(skos:definition @en)는 번역 검토 전이다",
     "@language": "ko"
    }
