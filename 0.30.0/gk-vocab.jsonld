    }
   ],
   "nmsc:instrumentEvidence": [
    {
     "@value": "AMI ← GK2A_QPN ← L2/RR(GK2A_RR) ← AMI L1B (운영 실행 스크립트) — 알고리즘 대응 추정 → 확실(위성자료처리 모델러 계약의 유형 관계 목록(비공개, 판 i) 계약 근거)",
     "@language": "ko"
    }
   ],
