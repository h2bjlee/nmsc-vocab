     "@value": "Simulated",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "simulated"
    }
   ],
   "skos:definition": [
    {
     "@value": "복사 전달 모델 등으로 모의한 값. 측정이 아니다. 예: 모의 밝기온도.",
     "@language": "ko"
    },
    {
     "@value": "A value simulated, for example with a radiative transfer model; it is not a measurement. Example: simulated brightness temperature.",
     "@language": "en"
    }
   ],
