     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "운형",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "구름을 꼭대기 기압과 광학두께에 따라 국제위성구름기후계획(ISCCP) 방식의 운형으로 분류한 결과.",
     "@language": "ko"
    },
    {
     "@value": "Classification of clouds into ISCCP-style cloud types according to cloud-top pressure and cloud optical thickness.",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Cloud Type",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "2019 약어 용어표 CT: CT 는 Cross Totals(불안정지수)와 다의어라 약어는 라벨로 달지 않았다",
     "@language": "ko"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-cloud-analysis"
    }
   ],
   "nmsc:productCategory": [
    {
     "@id": "prcat:cloud"
    }
   ],
   "nmsc:operationalAlgorithm": [
    {
     "@value": "GK2A_CLA"
    }
   ],
   "nmsc:producedByAlgorithm": [
    {
     "@id": "alg:gk2a-cla"
    }
   ],
   "nmsc:generationMethod": [
    {
     "@id": "genm:retrieved"
    }
   ],
   "nmsc:temporalRelation": [
    {
     "@id": "trel:observation"
    }
   ],
   "nmsc:operationalInput": [
    {
     "@id": "prod:daytime-cloud-optical-thickness"
    },
    {
     "@id": "prod:cloud-top-pressure"
    },
    {
     "@id": "prod:cloud-detection"
    }
   ],
   "nmsc:operationalInputEvidence": [
    {
     "@value": "알고리즘 입력 노드(nmsc:AlgorithmInput)에서 뽑은 단축 경로 — 역할 primary·intermediate, 자기 자신 제외: GK2A_CLA ← prod:daytime-cloud-optical-thickness(intermediate)·prod:cloud-top-pressure(intermediate)·prod:cloud-detection(intermediate). 외부 입력(extin:)은 단축 경로에 싣지 않는다. 보조·정적·보정 입력과 외부 입력은 노드에 있다",
     "@language": "ko"
    }
   ],
   "nmsc:satelliteObservationBased": [
    {
     "@value": "true",
     "@type": "xsd:boolean"
    }
   ],
   "nmsc:estimatesVariable": [
    {
     "@id": "var:cloud_type"
    }
   ],
   "nmsc:variableEvidence": [
    {
     "@value": "Cloud type ← GK2A_CLA → 출력 CT (ISCCP 구름형 1~9)",
     "@language": "ko"
    }
   ],
   "nmsc:processingLevel": [
    {
     "@id": "plev:l2"
    }
   ],
   "nmsc:processingLevelEvidence": [
    {
     "@value": "L2 ← GK2A_CLA → L2/CLA (출력 쓰기 모듈)",
     "@language": "ko"
    }
   ],
   "nmsc:derivedFromInstrument": [
    {
     "@id": "ins:ami"
    }
   ],
   "nmsc:instrumentEvidence": [
    {
     "@value": "AMI ← GK2A_CLA ← AMI L1B (운영 실행 스크립트)",
     "@language": "ko"
    }
   ],
   "dcat:spatialResolutionInMeters": [
    {
     "@value": "2000",
     "@type": "xsd:decimal"
    }
   ],
   "nmsc:coverageNote": [
    {
     "@value": "공간 해상도·산출 주기: 산출 주기 미확인 — 드라이버 보폭 10분(운영 실행 스크립트)는 재처리·시험 드라이버 값(국가기상위성센터 자료처리 코드저장소(비공개) 실행 스크립트는 처리 시각을 고정해 넣는 꼴) — 운영 crontab 이 위성자료처리 코드저장소에 없음, 운영 주기는 담당자 확인 필요(2026-11-19 확인)",
     "@language": "ko"
    }
   ],
   "dct:source": [
    {
     "@value": "공간 해상도·산출 주기 근거: 격자 간격 2 km 를 확인했다 — 위성자료처리 모델러의 알고리즘 재구현 명세(비공개, 2026-10-26 판) — 운형 CT 는 같은 CLA 2 km 파일(분석 자료 satellite-cloud-fraction) — 2026-11-18 읽음. 분석 자료는 위성자료처리 모델러의 운영 알고리즘 분석 자료(비공개, 2026-11-15 판)의 그 산출물 행, 명세는 같은 모델러의 알고리즘 재구현 명세(비공개)다. 일부 행은 2026-11-19 운영 코드 확인 결과를 근거로 함께 적는다",
     "@language": "ko"
    },
    {
     "@value": "산출물 → 처리 수준 판정 2026-11-13: 확실 운영 알고리즘 → NMSC 출력 서식표 항목의 level. 근거 자료: 국가기상위성센터 출력 서식표(비공개) — NMSC/ETRI AUX 라이브러리 출력 쓰기 모듈에서 뽑은 표",
     "@language": "ko"
    },
    {
     "@value": "산출물 → 탑재체 판정 2026-11-13: 확실 운영 알고리즘의 입력을 위성자료처리 모델러의 운영 실행 스크립트 입력 관계 분석 자료(비공개, 2026-11-13 판)으로 따라가 GK-2A AMI L1B·AMI L2 입력에 닿은 것",
     "@language": "ko"
    },
    {
     "@value": "산출물 → 변수 판정 2026-11-11: 확실 운영 알고리즘의 출력 변수(위성자료처리 모델러의 운영 알고리즘 분석 자료 모음(비공개, 2026-11-05 판) 모듈 명세·계약)와 OSCAR 변수 정의·단위를 대조",
     "@language": "ko"
    },
    {
     "@value": "위성자료처리 모델러의 운영 알고리즘 목록 정리 자료(비공개, 2026-11-05 판), 2026-11-11 수집",
     "@language": "ko"
    },
    {
     "@value": "NMSC 약어 용어표 d1.2 (2019-05-01), 2026-11-11 추출",
     "@language": "ko"
    },
    {
     "@value": "위성자료처리 모델러의 산출물 목록 정리 자료(비공개, 2026-11-05 판) (원천: NMSC 산출물 목록.hwpx, 2026-10-26 제공), 2026-11-11 수집",
     "@language": "ko"
    }
   ]
  },
