   "@id": "var:k_index",
   "@type": [
    "skos:Concept"
   ],
   "skos:inScheme": [
    {
     "@id": "nmsc:scheme/variable"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "K index",
     "@language": "en"
    },
    {
     "@value": "K 지수",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "850·700·500 hPa 의 기온과 이슬점으로 계산하는 대기 안정도 지수. 하층 수증기와 기온 감률을 함께 반영해 뇌우 가능성을 나타낸다.",
     "@language": "ko"
    },
    {
     "@value": "Atmospheric stability index computed from temperatures and dew points at 850, 700 and 500 hPa, combining lapse rate and low-level moisture to indicate thunderstorm potential.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "정의는 검토 전 초안이다(확신도 보통)",
     "@language": "ko"
    },
    {
     "@value": "CF closeMatch(atmosphere_stability_k_index): NMSC 위성 어휘가 정의한 변수",
     "@language": "ko"
    }
   ],
