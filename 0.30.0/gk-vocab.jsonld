    }
   ],
   "skos:prefLabel": [
    {
     "@value": "해독됨",
     "@language": "ko"
    },
    {
     "@value": "Decoded",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "decoded"
    }
   ],
   "skos:definition": [
    {
     "@value": "형식을 풀어 배열·필드로 꺼낸 자료. 보정 여부와 무관하다 — 보정 단계는 보정 단계 스킴(calibration-stage)으로 따로 적는다(예: 외부 L1C 밝기온도 = calibrated + decoded).",
     "@language": "ko"
    },
    {
     "@value": "Data unpacked from its encoding format into arrays or fields. Says nothing about calibration, which is recorded separately in the calibration-stage scheme.",
     "@language": "en"
    }
   ],
   "dct:source": [
    {
     "@value": "어휘 관리자 결정(2026-11-14)",
