    {
     "@value": "Modelled",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "modelled"
    }
   ],
   "skos:definition": [
    {
     "@value": "수치모델이 계산한 값. 예: 수치예보 모델의 예측장·분석장.",
     "@language": "ko"
    },
    {
     "@value": "A value computed by a numerical model. Example: forecast and analysis fields of a numerical weather prediction model.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "영어 정의(skos:definition @en)는 번역 검토 전이다",
     "@language": "ko"
    }
   ],
   "dct:source": [
    {
     "@value": "어휘 관리자 결정(2026-11-14)",
     "@language": "ko"
    },
    {
     "@value": "원 제안: 위성자료처리 모델러 설계 기록(비공개) '자료 객체 정의: 핵심·확장 층, 의무 수준, 자료 종류·단위·기원·시간 관계·이용 조건과 DBOM' (상태: 제안, 2026-11-14 작성 — 2026-11-15 읽어 값 확인) 생성 방법 표 — 위성자료처리 모델러 설계 기록(비공개) 표 modelled",
     "@language": "ko"
    }
   ]
  },
