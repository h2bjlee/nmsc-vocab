   "skos:prefLabel": [
    {
     "@value": "부호화 형식 그대로",
     "@language": "ko"
    },
    {
     "@value": "Encoded",
     "@language": "en"
    }
   ],
   "skos:notation": [
    {
     "@value": "encoded"
    }
   ],
   "skos:definition": [
    {
     "@value": "전송·부호화 형식(GRIB2·BUFR·고정 이진·목록 텍스트 등) 그대로의 자료.",
     "@language": "ko"
    },
    {
     "@value": "Data still in its transmission or encoding format (e.g. GRIB2, BUFR, fixed binary, listing text).",
     "@language": "en"
    }
   ],
   "dct:source": [
    {
     "@value": "어휘 관리자 결정(2026-11-14)",
