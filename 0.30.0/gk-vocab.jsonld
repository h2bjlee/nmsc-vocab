   "@type": [
    "owl:ObjectProperty"
   ],
   "rdfs:label": [
    {
     "@value": "관측 변수",
     "@language": "ko"
    }
   ],
   "rdfs:range": [
    {
     "@id": "nmsc:scheme/variable"
    }
   ]
  },
