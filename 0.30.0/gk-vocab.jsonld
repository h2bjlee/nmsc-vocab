   "skos:changeNote": [
    {
     "@value": "2026-11-15 생성 방법이 다른 운영 알고리즘 출력을 나눴다: prod:ai-atmospheric-instability(GK2A_ANN ml-inferred). 이 개념에 남은 노드: GK2A_AAP retrieved·MULTI_AAP retrieved.",
     "@language": "ko"
    }
   ]
