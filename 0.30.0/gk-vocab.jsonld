    }
   ],
   "skos:prefLabel": [
    {
     "@value": "강수",
     "@language": "ko"
    },
    {
     "@value": "Precipitation",
     "@language": "en"
    }
   ],
   "skos:definition": [
    {
     "@value": "값이 매겨지는 대상이 지표로 떨어지는 강수인 산출물의 물리 대상 그룹 — 관측하거나 예측한 강수 강도·누적량·확률과 호우 위험 정도.",
     "@language": "ko"
    },
    {
     "@value": "Physical-target group of products whose values describe rain and snow reaching the ground — observed or forecast rate, accumulated amount and probability, and how close conditions are to heavy rain.",
     "@language": "en"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "정의는 검토 전 초안이다(확신도 보통)",
     "@language": "ko"
    }
   ],
   "skos:scopeNote": [
    {
     "@value": "강수 강도·누적량·확률(관측·예측, 물리·기계학습·합성), 호우 임계 지수. 변수 영역 var:d-precipitation",
     "@language": "ko"
    },
    {
     "@value": "Precipitation intensity, accumulation and probability (observed and forecast; physical, machine learning and composite), heavy rain threshold index. Variable domain var:d-precipitation",
     "@language": "en"
    }
   ],
   "skos:closeMatch": [
