     "@value": "Atmospheric temperature",
     "@language": "en"
    },
    {
     "@value": "대기 온도",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "대기 중 기온의 3차원 분포.",
     "@language": "ko"
    },
    {
     "@value": "Three-dimensional field of air temperature in the atmosphere.",
