    }
   ],
   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "해양전선",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "해수면온도의 공간 경도가 큰 경계, 곧 성질이 다른 수괴가 만나는 해양 전선의 위치와 세기를 해수면온도 분석장에서 찾은 결과.",
     "@language": "ko"
    },
    {
     "@value": "Location and strength of ocean fronts — boundaries of strong spatial sea-surface-temperature gradient where different water masses meet — identified from a sea surface temperature analysis.",
     "@language": "en"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-ocean-monitoring"
    }
   ],
   "nmsc:productCategory": [
    {
     "@id": "prcat:ocean"
    }
   ],
   "nmsc:applicationArea": [
    {
     "@id": "prapp:ocean-monitoring"
    }
   ],
   "nmsc:operationalAlgorithm": [
