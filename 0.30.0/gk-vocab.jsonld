  {
   "@id": "prod:land-surface-temperature",
   "@type": [
    "skos:Concept"
   ],
   "skos:inScheme": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:topConceptOf": [
    {
     "@id": "nmsc:scheme/product"
    }
   ],
   "skos:prefLabel": [
    {
     "@value": "지표면온도",
     "@language": "ko"
    }
   ],
   "skos:definition": [
    {
     "@value": "맑은 하늘 육지에서 위성이 보는 지표(맨땅·식생) 표면의 온도(피부 온도)를 천리안위성 2A호(GK-2A) AMI 관측으로 추정한 값.",
     "@language": "ko"
    },
    {
     "@value": "Temperature of the apparent land surface (bare soil or vegetation) seen by the satellite under clear sky (skin temperature), estimated from GK-2A AMI observations.",
     "@language": "en"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Land Surface Temperature",
     "@language": "en"
    },
    {
     "@value": "LST",
     "@language": "en"
    }
   ],
   "nmsc:productGroup": [
    {
     "@id": "prgr:sg-land-surface-temperature"
    }
   ],
   "nmsc:productCategory": [
    {
     "@id": "prcat:land-surface"
    }
   ],
   "nmsc:operationalAlgorithm": [
    {
