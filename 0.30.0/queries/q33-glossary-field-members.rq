PREFIX nmsc:  <https://w3id.org/nmsc/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:   <http://purl.org/dc/terms/>

# ── Q33. 용어집 분야 → 그 분야에 속한 용어
#    분야는 glossary/field/<code> 의 skos:Collection 이고, 소속은 Collection 쪽 skos:member 다(vocab/glossary/glossary-fields.ttl).
#    대상은 세 종류 — 용어집 항목(nmsc:GlossaryEntry, glossary/gNNNN), NMSC 위성 어휘 개념, 외부 IRI(NMSC 사용 노트의 주어).
#    한 대상이 여러 분야에 나올 수 있다(주 분야 + 부 분야). 기타(other)는 공개 분야가 아니라 나오지 않는다.
#    ?이름 은 항목·개념의 한국어 대표 이름. 외부 IRI 는 정의가 원본에 있어 여기서는 비어 있다(NMSC 사용 이름은 q32-glossary-notes-for-concept.rq 처럼 nmsc:nmscLabel).
#    임시 소속(검토 전 초안)은 공개 파일에 없으므로 나오지 않는다.
# data: glossary
SELECT ?분야 ?분야이름 ?종류 ?대상 ?이름
WHERE {
  ?분야 a skos:Collection ;
        dct:isPartOf nmsc:glossary ;
        skos:prefLabel ?분야이름 ;
        skos:member ?대상 .
  FILTER (LANG(?분야이름) = "ko")
  OPTIONAL { ?대상 a ?t . FILTER (?t = nmsc:GlossaryEntry) }
  OPTIONAL { ?대상 a ?c . FILTER (?c = skos:Concept) }
  BIND (IF(BOUND(?t), "용어집 항목", IF(BOUND(?c), "어휘 개념", "외부 IRI")) AS ?종류)
  OPTIONAL { ?대상 skos:prefLabel ?이름 . FILTER (LANG(?이름) = "ko") FILTER (BOUND(?t) || BOUND(?c)) }
}
ORDER BY ?분야 ?종류 ?대상
