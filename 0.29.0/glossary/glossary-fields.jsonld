   "skos:prefLabel": [
    {
     "@value": "위성(위성 프로그램)",
     "@language": "ko"
    },
    {
     "@value": "Satellite missions and programmes",
     "@language": "en"
    }
   ],
   "skos:scopeNote": [
    {
     "@value": "넣는 것: 위성·위성 시리즈·프로그램·임무 이름, 위성 항법 체계, 궤도 종류·임무 차원의 궤도 개념",
     "@language": "ko"
    }
   ],
   "skos:editorialNote": [
    {
     "@value": "영문 이름은 원본에 없어 NMSC 위성 어휘가 한국어 분야 이름을 옮긴 것이다(2026-11-14) — 번역 검토 전.",
     "@language": "ko"
    }
   ],
   "dct:source": [
    {
     "@value": "용어집 분야 구분 — 분야별 검토 묶음으로 시작(2026-11-12), 위성관제 분리(2026-11-13), 부 분야 허용·분야 Collection 공개(어휘 관리자 결정(2026-11-14)). 분야 소속은 검토 전 초안 분류다",
     "@language": "ko"
    }
   ],
