PREFIX nmsc:  <https://w3id.org/nmsc/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>

# ── Q35. 산출물 → 운영 알고리즘(IRI) (C15 단계 2, status 95)
#    nmsc:producedByAlgorithm(결정 S2-3 — 문자열 nmsc:operationalAlgorithm 과 병행, 문자열은 다음 판에 폐기 표시)과
#    알고리즘의 algorepo 운영 이름(skos:notation, S2-2). 같은 행의 문자열 값과 notation 이 같아야 한다(?같음).
#    생성 방법·시간 관계의 유형 수준 값은 결정 S2-4 가 남아 아직 없다.
SELECT ?산출물 ?산출물라벨 ?알고리즘 ?notation ?같음
WHERE {
  ?산출물 nmsc:producedByAlgorithm ?알고리즘 ;
          skos:prefLabel ?산출물라벨 . FILTER(lang(?산출물라벨) = "ko")
  ?알고리즘 skos:notation ?notation .
  BIND(EXISTS { ?산출물 nmsc:operationalAlgorithm ?notation } AS ?같음)
}
ORDER BY ?산출물 ?notation
