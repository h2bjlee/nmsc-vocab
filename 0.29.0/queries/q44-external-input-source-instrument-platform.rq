PREFIX nmsc: <https://w3id.org/nmsc/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# ── Q44. 외부 입력의 원천 기기·위성 — "이 산출물이 쓰는 다른 위성 자료는 어느 기기·위성에서 오는가" (status 100 — 원천 src/external_input_links.tsv)
#    외부 입력 개념(scheme/external-input)의 nmsc:sourceInstrument·nmsc:sourcePlatform(SKOS 대응이 아닌 전용 속성).
#    값은 확인 기록 docs/external-input-iri-check.tsv 에 있는 OSCAR·GCMD IRI, 또는 NMSC 위성 어휘의 탑재체·위성(ins:·sat:).
#    입력노드 = 그 외부 입력을 입력원으로 쓰는 알고리즘 입력 노드(nmsc:AlgorithmInput) 수.
SELECT ?외부입력 ?라벨 ?종류 ?레지스트리 ?대상 ?입력노드
WHERE {
  {
    SELECT ?e ?종류 ?t (COUNT(DISTINCT ?n) AS ?입력노드)
    WHERE {
      VALUES (?종류 ?prop) { ("기기" nmsc:sourceInstrument) ("위성" nmsc:sourcePlatform) }
      ?e skos:inScheme <https://w3id.org/nmsc/scheme/external-input> ;
         ?prop ?t .
      OPTIONAL { ?n a nmsc:AlgorithmInput ; nmsc:inputSource ?e }
    }
    GROUP BY ?e ?종류 ?t
  }
  ?e skos:prefLabel ?l .
  FILTER(LANG(?l) = "ko")
  BIND(REPLACE(STR(?e), "^.*/", "") AS ?외부입력)
  BIND(STR(?l) AS ?라벨)
  BIND(IF(STRSTARTS(STR(?t), "https://space.oscar.wmo.int/"), "OSCAR",
       IF(STRSTARTS(STR(?t), "https://gcmd.earthdata.nasa.gov/"), "GCMD", "NMSC")) AS ?레지스트리)
  BIND(STR(?t) AS ?대상)
}
ORDER BY ?외부입력 ?종류 ?레지스트리 ?대상
