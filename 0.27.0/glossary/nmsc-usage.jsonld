   "nmsc:nmscLabel": [
    {
     "@value": "ARGO"
    }
   ],
   "nmsc:nmscNote": [
    {
     "@value": "전 세계 해양에 투입되어 수온·염분을 자동 관측하는 원통형 무인 뜰개(float). 길이 약 180cm, 무게 약 26kg이며, 3~5년 동안 수심 800m~2,000m 사이를 초당 약 10cm 속도로 오르내리며 측정한다. 국제 해양관측 프로그램 Argo 의 관측 장비이며, 기상청 국립기상과학원은 2001년부터 플로트를 투하하고 아르고 지역자료센터를 운영한다",
     "@language": "ko"
    }
   ],
   "dct:source": [
